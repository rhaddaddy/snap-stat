<?xml version="1.0" encoding="utf-8"?>
<!-- The same for Android 12 and newer: no tracker log or waiting pictures in backups or when moving to a new phone. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="log.txt" />
        <exclude domain="file" path="queue/" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="log.txt" />
        <exclude domain="file" path="queue/" />
    </device-transfer>
</data-extraction-rules>
