<?xml version="1.0" encoding="utf-8"?>
<!-- The SNAP Stat home-screen widget when it's big: today, the resets, the season, the event, the web shop, your numbers and your alliance -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@drawable/widget_bg" android:orientation="vertical" android:padding="11dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal" android:paddingStart="3dp" android:paddingEnd="3dp">
        <ImageView android:layout_width="26dp" android:layout_height="26dp" android:contentDescription="@string/app_name" android:src="@mipmap/ic_launcher_fg" />
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="6dp" android:orientation="vertical">
            <TextView android:id="@+id/w_name" android:layout_width="match_parent" android:layout_height="wrap_content" android:ellipsize="end" android:maxLines="1" android:text="@string/app_name" android:textColor="#FFFFFF" android:textSize="15sp" android:textStyle="bold" />
            <TextView android:id="@+id/w_season" android:layout_width="match_parent" android:layout_height="wrap_content" android:ellipsize="end" android:maxLines="1" android:textColor="#DCD3FF" android:textSize="11sp" />
        </LinearLayout>
        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="end">
            <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/widget_rank" android:textColor="#BDAFE6" android:textSize="11sp" />
                <TextView android:id="@+id/w_rank" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="4dp" android:text="—" android:textColor="#FFD23F" android:textSize="22sp" android:textStyle="bold" />
            </LinearLayout>
            <TextView android:id="@+id/w_rank_sub" android:layout_width="wrap_content" android:layout_height="wrap_content" android:maxLines="1" android:textColor="#BDAFE6" android:textSize="10sp" />
        </LinearLayout>
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:layout_marginTop="6dp" android:orientation="vertical">
        
    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal">
        <LinearLayout android:id="@+id/w_t_today" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_margin="3dp"
            android:background="@drawable/widget_tile_bg" android:orientation="vertical" android:gravity="center_vertical" android:paddingStart="10dp" android:paddingEnd="8dp" android:paddingTop="6dp" android:paddingBottom="6dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="TODAY" android:textColor="#BDAFE6" android:textSize="10sp" android:textStyle="bold" android:maxLines="1" />
            <TextView android:id="@+id/w_today" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#FFFFFF" android:textSize="17sp" android:textStyle="bold" android:maxLines="1" android:ellipsize="end" />
            <TextView android:id="@+id/w_today_sub" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#BDAFE6" android:textSize="11sp"  android:maxLines="1" android:ellipsize="end" />
        </LinearLayout>
        <LinearLayout android:id="@+id/w_t_reset" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_margin="3dp"
            android:background="@drawable/widget_tile_bg" android:orientation="vertical" android:gravity="center_vertical" android:paddingStart="10dp" android:paddingEnd="8dp" android:paddingTop="6dp" android:paddingBottom="6dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="DAILY RESET IN" android:textColor="#BDAFE6" android:textSize="10sp" android:textStyle="bold" android:maxLines="1" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="bottom">
                <Chronometer android:id="@+id/w_reset" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#8FE3FF" android:textSize="17sp" android:textStyle="bold" />
            </LinearLayout>
            <TextView android:id="@+id/w_reset_at" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#BDAFE6" android:textSize="11sp"  android:maxLines="1" android:ellipsize="end" />
        </LinearLayout>
    </LinearLayout>
        
    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal">
        <LinearLayout android:id="@+id/w_t_season" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_margin="3dp"
            android:background="@drawable/widget_tile_bg" android:orientation="vertical" android:gravity="center_vertical" android:paddingStart="10dp" android:paddingEnd="8dp" android:paddingTop="6dp" android:paddingBottom="6dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="THIS SEASON" android:textColor="#BDAFE6" android:textSize="10sp" android:textStyle="bold" android:maxLines="1" />
            <TextView android:id="@+id/w_seasonrec" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#FFFFFF" android:textSize="16sp" android:textStyle="bold" android:maxLines="1" android:ellipsize="end" />
            <TextView android:id="@+id/w_season_sub" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#BDAFE6" android:textSize="11sp"  android:maxLines="1" android:ellipsize="end" />
        </LinearLayout>
        <LinearLayout android:id="@+id/w_t_refresh" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_margin="3dp"
            android:background="@drawable/widget_tile_bg" android:orientation="vertical" android:gravity="center_vertical" android:paddingStart="10dp" android:paddingEnd="8dp" android:paddingTop="6dp" android:paddingBottom="6dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="MISSION REFRESH IN" android:textColor="#BDAFE6" android:textSize="10sp" android:textStyle="bold" android:maxLines="1" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="bottom">
                <Chronometer android:id="@+id/w_refresh" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#8FE3FF" android:textSize="17sp" android:textStyle="bold" />
            </LinearLayout>
            <TextView android:id="@+id/w_refresh_at" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#BDAFE6" android:textSize="11sp"  android:maxLines="1" android:ellipsize="end" />
        </LinearLayout>
    </LinearLayout>
        
    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal">
        <LinearLayout android:id="@+id/w_t_event" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_margin="3dp"
            android:background="@drawable/widget_tile_bg" android:orientation="vertical" android:gravity="center_vertical" android:paddingStart="10dp" android:paddingEnd="8dp" android:paddingTop="6dp" android:paddingBottom="6dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="EVENT" android:textColor="#BDAFE6" android:textSize="10sp" android:textStyle="bold" android:maxLines="1" />
            <TextView android:id="@+id/w_event" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#FFFFFF" android:textSize="14sp" android:textStyle="bold" android:maxLines="1" android:ellipsize="end" />
            <TextView android:id="@+id/w_event_sub" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#BDAFE6" android:textSize="11sp"  android:maxLines="1" android:ellipsize="end" />
        </LinearLayout>
        <LinearLayout android:id="@+id/w_t_web" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_margin="3dp"
            android:background="@drawable/widget_tile_bg" android:orientation="vertical" android:gravity="center_vertical" android:paddingStart="10dp" android:paddingEnd="8dp" android:paddingTop="6dp" android:paddingBottom="6dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="WEB SHOP" android:textColor="#BDAFE6" android:textSize="10sp" android:textStyle="bold" android:maxLines="1" />
            <TextView android:id="@+id/w_web" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#FFFFFF" android:textSize="14sp" android:textStyle="bold" android:maxLines="1" android:ellipsize="end" />
            <TextView android:id="@+id/w_web_sub" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#BDAFE6" android:textSize="11sp"  android:maxLines="1" android:ellipsize="end" />
        </LinearLayout>
    </LinearLayout>
        
    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal">
        <LinearLayout android:id="@+id/w_t_money" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_margin="3dp"
            android:background="@drawable/widget_tile_bg" android:orientation="vertical" android:gravity="center_vertical" android:paddingStart="10dp" android:paddingEnd="8dp" android:paddingTop="6dp" android:paddingBottom="6dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="CREDITS · GOLD · TOKENS" android:textColor="#BDAFE6" android:textSize="10sp" android:textStyle="bold" android:maxLines="1" />
            <TextView android:id="@+id/w_money" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#FFFFFF" android:textSize="14sp" android:textStyle="bold" android:maxLines="1" android:ellipsize="end" />
            <TextView android:id="@+id/w_money_sub" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#BDAFE6" android:textSize="11sp"  android:maxLines="1" android:ellipsize="end" />
        </LinearLayout>
        <LinearLayout android:id="@+id/w_t_ally" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_margin="3dp"
            android:background="@drawable/widget_tile_bg" android:orientation="vertical" android:gravity="center_vertical" android:paddingStart="10dp" android:paddingEnd="8dp" android:paddingTop="6dp" android:paddingBottom="6dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="ALLIANCE" android:textColor="#BDAFE6" android:textSize="10sp" android:textStyle="bold" android:maxLines="1" />
            <TextView android:id="@+id/w_ally" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#FFFFFF" android:textSize="14sp" android:textStyle="bold" android:maxLines="1" android:ellipsize="end" />
            <TextView android:id="@+id/w_ally_sub" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#BDAFE6" android:textSize="11sp"  android:maxLines="1" android:ellipsize="end" />
        </LinearLayout>
    </LinearLayout>
    </LinearLayout>
    <TextView android:id="@+id/w_alert" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginStart="3dp" android:layout_marginEnd="3dp" android:layout_marginTop="4dp"
        android:background="@drawable/widget_alert_bg" android:ellipsize="end" android:maxLines="1" android:paddingStart="8dp" android:paddingTop="3dp" android:paddingEnd="8dp" android:paddingBottom="3dp" android:textColor="#FFFFFF" android:textSize="12sp" android:visibility="gone" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:orientation="horizontal">
        <TextView android:id="@+id/w_play" android:layout_width="0dp" android:layout_height="38dp" android:layout_weight="1.3" android:layout_marginStart="3dp" android:layout_marginEnd="3dp" android:background="@drawable/widget_btn_bg"
            android:gravity="center" android:text="@string/widget_play" android:textColor="#1A0E3D" android:textSize="13sp" android:textStyle="bold" android:maxLines="1" />
        <TextView android:id="@+id/w_webbtn" android:layout_width="0dp" android:layout_height="38dp" android:layout_weight="1" android:layout_marginStart="3dp" android:layout_marginEnd="3dp" android:background="@drawable/widget_btn2_bg"
            android:gravity="center" android:text="@string/widget_webshop" android:textColor="#FFFFFF" android:textSize="13sp" android:textStyle="bold" android:maxLines="1" />
    </LinearLayout>
</LinearLayout>
